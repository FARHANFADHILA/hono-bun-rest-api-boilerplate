model bahan_kajian {
  id                                 String                              @id
  kode                               String                              @db.VarChar(10)
  nama                               String                              @db.VarChar(60)
  deskripsi                          String
  deskripsi_inggris                  String
  tahun                              Int
  created_by                         String?                             @db.Uuid
  updated_by                         String?                             @db.Uuid
  created_at                         DateTime                            @default(now())
  updated_at                         DateTime?
  id_prodi                           String
  nama_inggris                       String                              @db.VarChar(60)
  akun_bahan_kajian_created_byToakun akun?                               @relation("bahan_kajian_created_byToakun", fields: [created_by], references: [id])
  program_studi                      program_studi                       @relation(fields: [id_prodi], references: [id])
  akun_bahan_kajian_updated_byToakun akun?                               @relation("bahan_kajian_updated_byToakun", fields: [updated_by], references: [id])
  cpl_bk                             cpl_bk[]
  mk_bk                              mk_bk[]
  rps_pertemuan_materi_pembelajaran  rps_pertemuan_materi_pembelajaran[]
}

model bentuk_pembelajaran {
  id                                String                              @id @db.VarChar(30)
  nama                              String                              @db.VarChar(60)
  rps_pertemuan_bentuk_pembelajaran rps_pertemuan_bentuk_pembelajaran[]
}

model bentuk_penilaian {
  id                             String                           @id @db.VarChar(30)
  nama                           String                           @db.VarChar(60)
  akronim                        String?                          @db.VarChar(10)
  deskripsi                      String?
  nilai_mahasiswa                nilai_mahasiswa[]
  nilai_mahasiswa_pertemuan      nilai_mahasiswa_pertemuan[]
  rps_pertemuan_bentuk_penilaian rps_pertemuan_bentuk_penilaian[]
}

model capaian_pembelajaran_lulusan {
  id                                                 String        @id
