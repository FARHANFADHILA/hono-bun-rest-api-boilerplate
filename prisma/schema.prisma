  pl_cpl_pl_cpl_created_byToakun                                                             pl_cpl[]                               @relation("pl_cpl_created_byToakun")
  pl_cpl_pl_cpl_updated_byToakun                                                             pl_cpl[]                               @relation("pl_cpl_updated_byToakun")
  profil_lulusan_profil_lulusan_created_byToakun                                             profil_lulusan[]                       @relation("profil_lulusan_created_byToakun")
  profil_lulusan_profil_lulusan_updated_byToakun                                             profil_lulusan[]                       @relation("profil_lulusan_updated_byToakun")
  program_studi_program_studi_created_byToakun                                               program_studi[]                        @relation("program_studi_created_byToakun")
  program_studi_program_studi_updated_byToakun                                               program_studi[]                        @relation("program_studi_updated_byToakun")
  rps_rps_created_byToakun                                                                   rps[]                                  @relation("rps_created_byToakun")
