  fakultas_fakultas_created_byToakun                                                         Fakultas[]                             @relation("fakultas_created_byToakun")
  fakultas_fakultas_updated_byToakun                                                         Fakultas[]                             @relation("fakultas_updated_byToakun")
  kaprodi_kaprodi_created_byToakun                                                           kaprodi[]                              @relation("kaprodi_created_byToakun")
  kaprodi_kaprodi_updated_byToakun                                                           kaprodi[]                              @relation("kaprodi_updated_byToakun")
  kelas_kuliah_kelas_kuliah_created_byToakun                                                 kelas_kuliah[]                         @relation("kelas_kuliah_created_byToakun")
  kelas_kuliah_kelas_kuliah_updated_byToakun                                                 kelas_kuliah[]                         @relation("kelas_kuliah_updated_byToakun")
  krs_krs_created_byToakun                                                                   krs[]                                  @relation("krs_created_byToakun")
  krs_krs_updated_byToakun                                                                   krs[]                                  @relation("krs_updated_byToakun")
  mahasiswa_mahasiswa_created_byToakun                                                       mahasiswa[]                            @relation("mahasiswa_created_byToakun")
  mahasiswa_mahasiswa_updated_byToakun                                                       mahasiswa[]                            @relation("mahasiswa_updated_byToakun")
