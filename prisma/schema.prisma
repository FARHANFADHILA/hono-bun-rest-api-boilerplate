  akun_capaian_pembelajaran_lulusan_updated_byToakun akun?         @relation("capaian_pembelajaran_lulusan_updated_byToakun", fields: [updated_by], references: [id])
  cpl_bk                                             cpl_bk[]
  cpl_cpmk                                           cpl_cpmk[]
  cpl_mk                                             cpl_mk[]
  pl_cpl                                             pl_cpl[]
}

model capaian_pembelajaran_mata_kuliah {
