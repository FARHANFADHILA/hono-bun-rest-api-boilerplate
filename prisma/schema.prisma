  mata_kuliah_mata_kuliah_updated_byToakun                                                   mata_kuliah[]                          @relation("mata_kuliah_updated_byToakun")
  mata_kuliah_prasyarat_mata_kuliah_prasyarat_created_byToakun                               mata_kuliah_prasyarat[]                @relation("mata_kuliah_prasyarat_created_byToakun")
  mata_kuliah_prasyarat_mata_kuliah_prasyarat_updated_byToakun                               mata_kuliah_prasyarat[]                @relation("mata_kuliah_prasyarat_updated_byToakun")
  mk_bk_mk_bk_created_byToakun                                                               mk_bk[]                                @relation("mk_bk_created_byToakun")
  mk_bk_mk_bk_updated_byToakun                                                               mk_bk[]                                @relation("mk_bk_updated_byToakun")
