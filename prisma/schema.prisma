  mk_cpmk_mk_cpmk_updated_byToakun                                                           mk_cpmk[]                              @relation("mk_cpmk_updated_byToakun")
  nilai_mahasiswa_nilai_mahasiswa_created_byToakun                                           nilai_mahasiswa[]                      @relation("nilai_mahasiswa_created_byToakun")
  nilai_mahasiswa_nilai_mahasiswa_updated_byToakun                                           nilai_mahasiswa[]                      @relation("nilai_mahasiswa_updated_byToakun")
  nilai_mahasiswa_pertemuan_nilai_mahasiswa_pertemuan_created_byToakun                       nilai_mahasiswa_pertemuan[]            @relation("nilai_mahasiswa_pertemuan_created_byToakun")
