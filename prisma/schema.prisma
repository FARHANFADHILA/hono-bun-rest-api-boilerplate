  rps_daftar_pustaka_rps_daftar_pustaka_updated_byToakun                                     rps_daftar_pustaka[]                   @relation("rps_daftar_pustaka_updated_byToakun")
  rps_metode_pembelajaran_rps_metode_pembelajaran_created_byToakun                           rps_metode_pembelajaran[]              @relation("rps_metode_pembelajaran_created_byToakun")
  rps_metode_pembelajaran_rps_metode_pembelajaran_updated_byToakun                           rps_metode_pembelajaran[]              @relation("rps_metode_pembelajaran_updated_byToakun")
  rps_pertemuan_rps_pertemuan_created_byToakun                                               rps_pertemuan[]                        @relation("rps_pertemuan_created_byToakun")
  rps_pertemuan_rps_pertemuan_updated_byToakun                                               rps_pertemuan[]                        @relation("rps_pertemuan_updated_byToakun")
  rps_pertemuan_bentuk_pembelajaran_rps_pertemuan_bentuk_pembelajaran_created_byToakun       rps_pertemuan_bentuk_pembelajaran[]    @relation("rps_pertemuan_bentuk_pembelajaran_created_byToakun")
  rps_pertemuan_bentuk_pembelajaran_rps_pertemuan_bentuk_pembelajaran_updated_byToakun       rps_pertemuan_bentuk_pembelajaran[]    @relation("rps_pertemuan_bentuk_pembelajaran_updated_byToakun")
  rps_pertemuan_bentuk_penilaian_rps_pertemuan_bentuk_penilaian_created_byToakun             rps_pertemuan_bentuk_penilaian[]       @relation("rps_pertemuan_bentuk_penilaian_created_byToakun")
