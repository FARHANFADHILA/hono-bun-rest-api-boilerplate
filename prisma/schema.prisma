generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Universitas {
  id                                String     @id @default(uuid())
  nama                              String     @db.VarChar(100)
  akronim                           String?    @db.VarChar(60)
  created_by                        String?    @db.Uuid
  updated_by                        String?    @db.Uuid
  created_at                        DateTime   @default(now())
  updated_at                        DateTime?  @updatedAt
  fakultas                          Fakultas[]
  akun_universitas_created_byToakun akun?      @relation("universitas_created_byToakun", fields: [created_by], references: [id])
  akun_universitas_updated_byToakun akun?      @relation("universitas_updated_byToakun", fields: [updated_by], references: [id])

  @@map("universitas")
}

model Fakultas {
  id                             String          @id @default(uuid())
  kode                           String          @db.VarChar(10)
  nama                           String          @db.VarChar(60)
  created_by                     String?         @db.Uuid
  updated_by                     String?         @db.Uuid
  created_at                     DateTime        @default(now())
  updated_at                     DateTime?       @updatedAt
  id_universitas                 String
  akun_fakultas_created_byToakun akun?           @relation("fakultas_created_byToakun", fields: [created_by], references: [id])
  universitas                    Universitas     @relation(fields: [id_universitas], references: [id])
  akun_fakultas_updated_byToakun akun?           @relation("fakultas_updated_byToakun", fields: [updated_by], references: [id])
  program_studi                  program_studi[]

  @@map("fakultas")
}

model akun {
  id                                                                                         String                                 @id @db.Uuid
  nama                                                                                       String                                 @db.VarChar(255)
  email                                                                                      String                                 @db.VarChar(225)
  avatar_url                                                                                 String?                                @db.VarChar(225)
  id_google                                                                                  String?                                @db.VarChar(225)
  created_at                                                                                 DateTime                               @default(now())
  updated_at                                                                                 DateTime?
  id_prodi                                                                                   String
  id_keycloak                                                                                String?                                @db.VarChar(225)
  program_studi_akun_id_prodiToprogram_studi                                                 program_studi                          @relation("akun_id_prodiToprogram_studi", fields: [id_prodi], references: [id])
  bahan_kajian_bahan_kajian_created_byToakun                                                 bahan_kajian[]                         @relation("bahan_kajian_created_byToakun")
  bahan_kajian_bahan_kajian_updated_byToakun                                                 bahan_kajian[]                         @relation("bahan_kajian_updated_byToakun")
  capaian_pembelajaran_lulusan_capaian_pembelajaran_lulusan_created_byToakun                 capaian_pembelajaran_lulusan[]         @relation("capaian_pembelajaran_lulusan_created_byToakun")
  capaian_pembelajaran_lulusan_capaian_pembelajaran_lulusan_updated_byToakun                 capaian_pembelajaran_lulusan[]         @relation("capaian_pembelajaran_lulusan_updated_byToakun")
  capaian_pembelajaran_mata_kuliah_capaian_pembelajaran_mata_kuliah_created_byToakun         capaian_pembelajaran_mata_kuliah[]     @relation("capaian_pembelajaran_mata_kuliah_created_byToakun")
  capaian_pembelajaran_mata_kuliah_capaian_pembelajaran_mata_kuliah_updated_byToakun         capaian_pembelajaran_mata_kuliah[]     @relation("capaian_pembelajaran_mata_kuliah_updated_byToakun")
  cpl_bk_cpl_bk_created_byToakun                                                             cpl_bk[]                               @relation("cpl_bk_created_byToakun")
  cpl_bk_cpl_bk_updated_byToakun                                                             cpl_bk[]                               @relation("cpl_bk_updated_byToakun")
  cpl_cpmk_cpl_cpmk_created_byToakun                                                         cpl_cpmk[]                             @relation("cpl_cpmk_created_byToakun")
  cpl_cpmk_cpl_cpmk_updated_byToakun                                                         cpl_cpmk[]                             @relation("cpl_cpmk_updated_byToakun")
  cpl_mk_cpl_mk_created_byToakun                                                             cpl_mk[]                               @relation("cpl_mk_created_byToakun")
  cpl_mk_cpl_mk_updated_byToakun                                                             cpl_mk[]                               @relation("cpl_mk_updated_byToakun")
  detail_mata_kuliah_detail_mata_kuliah_created_byToakun                                     detail_mata_kuliah[]                   @relation("detail_mata_kuliah_created_byToakun")
